# ---- Site (público; vai para o navegador) -> variáveis do repositório GitHub
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx   # ou a chave "anon"

# ---- Servidor (NUNCA no navegador) -> secrets do GitHub / Supabase
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=                 # só no worker (GitHub secret)
TOKEN_ENCRYPTION_KEY=                      # openssl rand -base64 32 (mesmo valor no Supabase e no worker)
CRON_SECRET=                               # openssl rand -hex 24 (também no Vault: cron_secret)
APP_URL=https://USUARIO.github.io/autovideo-short/
GEMINI_API_KEY=                            # opcional: chave padrão (o usuário pode salvar a própria no painel)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
GITHUB_DISPATCH_TOKEN=                     # token fine-grained com "Contents: read and write" neste repositório
GITHUB_REPOSITORY=usuario/autovideo-short
